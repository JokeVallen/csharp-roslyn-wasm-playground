    private void ApplyStyleParameters()
    {
        theme = NormalizeOption(GetQueryParameter("theme"), "dark", "dark", "light", "auto");
        layout = NormalizeOption(GetQueryParameter("layout"), "split", "split", "stacked");
        chrome = NormalizeOption(GetQueryParameter("chrome"), "full", "full", "minimal", "none");
        density = NormalizeOption(GetQueryParameter("density"), "comfortable", "comfortable", "compact");
        completionMode = NormalizeOption(GetQueryParameter("completion"), "auto", "auto", "manual");
        prewarmCompiler = AutoSemanticCompletion;
        targetFramework = NormalizeTargetFramework(GetQueryParameter("target"));
        if (!SupportedTargetFrameworks.Contains(targetFramework))
        {
            targetFramework = DefaultTargetFramework;
        }

        var requestedAccent = GetQueryParameter("accent");
        if (!string.IsNullOrWhiteSpace(requestedAccent))
        {
            accentName = requestedAccent.Trim();
        }

        if (double.TryParse(GetQueryParameter("radius"), out var radius))
        {
            cornerRadius = Math.Clamp(radius, 0, 32);
        }

        if (double.TryParse(GetQueryParameter("fontsize"), out var fontSize))
        {
            editorFontSize = Math.Clamp(fontSize, 11, 22);
        }
    }

    private void ApplyCodeParameter()
    {
        var readonlyValue = GetQueryParameter("readonly");
        readonlyMode = readonlyValue is "1" || string.Equals(readonlyValue, "true", StringComparison.OrdinalIgnoreCase);

        var encoded = GetQueryParameter("code");
        if (string.IsNullOrWhiteSpace(encoded))
        {
            return;
        }

        try
        {
            var normalized = encoded.Replace('-', '+').Replace('_', '/');
            normalized = normalized.PadRight((normalized.Length + 3) / 4 * 4, '=');
            var decoded = Encoding.UTF8.GetString(Convert.FromBase64String(normalized));
            if (string.IsNullOrWhiteSpace(decoded))
            {
                return;
            }

            sourceCode = decoded;
            displayCode = decoded;
            showFullCode = decoded.Contains("class ", StringComparison.Ordinal) ||
                           decoded.Contains("using ", StringComparison.Ordinal);
        }
        catch
        {
            // Ignore malformed ?code= values and keep the default sample.
        }
    }

    private string? GetQueryParameter(string name)
    {
        var query = new Uri(Navigation.Uri).Query.TrimStart('?');
        if (string.IsNullOrEmpty(query))
        {
            return null;
        }

        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var separator = pair.IndexOf('=');
            var key = separator >= 0 ? pair[..separator] : pair;
            if (!string.Equals(Uri.UnescapeDataString(key), name, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return separator >= 0
                ? Uri.UnescapeDataString(pair[(separator + 1)..].Replace('+', ' '))
                : string.Empty;
        }

        return null;
    }

    private static string NormalizeOption(string? value, string fallback, params string[] allowed)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        var candidate = value.Trim().ToLowerInvariant();
        return allowed.Contains(candidate) ? candidate : fallback;
    }

    private static string NormalizeTargetFramework(string? value)
    {
        return (value ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            "net8" or "net8.0" => "net8.0",
            "net9" or "net9.0" => "net9.0",
            "net10" or "net10.0" => "net10.0",
            _ => DefaultTargetFramework
        };
    }

    private static Type GetReferenceAssemblyType(string target)
    {
#if NET8_0
        return typeof(Basic.Reference.Assemblies.Net80);
#elif NET9_0
        return target == "net9.0"
            ? typeof(Basic.Reference.Assemblies.Net90)
            : typeof(Basic.Reference.Assemblies.Net80);
#else
        return target switch
        {
            "net8.0" => typeof(Basic.Reference.Assemblies.Net80),
            "net9.0" => typeof(Basic.Reference.Assemblies.Net90),
            _ => typeof(Basic.Reference.Assemblies.Net100)
        };
#endif
#if false
        // Unreachable fallback retained for older compilers.
        return target == "net8.0"
            ? typeof(Basic.Reference.Assemblies.Net80)
            : typeof(Basic.Reference.Assemblies.Net90);
#endif
    }

