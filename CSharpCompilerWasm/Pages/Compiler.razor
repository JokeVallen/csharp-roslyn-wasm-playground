    private async Task FormatCodeAsync()
    {
        if (isFormatting)
        {
            return;
        }

        HideCompletion();
        isFormatting = true;
        StateHasChanged();

        var caret = 0;
        try
        {
            caret = await JSRuntime.InvokeAsync<int>("playgroundCompletion.getSelectionStart", "code-editor");

            if (!showFullCode)
            {
                OnCodeChanged(new ChangeEventArgs { Value = displayCode });
            }

            var formatted = await JSRuntime.InvokeAsync<string>("roslynWorker.format", sourceCode);
            if (!string.IsNullOrWhiteSpace(formatted))
            {
                sourceCode = formatted.TrimEnd();
                UpdateDisplayCode();
                await Task.Delay(20);
                await JSRuntime.InvokeVoidAsync(
                    "playgroundCompletion.setSelectionStart",
                    "code-editor",
                    Math.Min(caret, displayCode.Length));
            }
        }
        catch (Exception ex)
        {
            AddErrorOutput($"Format error: {ex.Message}", "error");
        }
        finally
        {
            isFormatting = false;
            StateHasChanged();
        }
    }

