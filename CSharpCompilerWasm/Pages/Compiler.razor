    private async Task OnCodeInputAsync()
    {
        var accepted = false;
        var entered = false;
        try
        {
            accepted = await JSRuntime.InvokeAsync<bool>("playgroundCompletion.consumeAccepted");
            entered = await JSRuntime.InvokeAsync<bool>("playgroundCompletion.consumeEnter");
        }
        catch
        {
            // Completion interop is optional.
        }

        if (accepted && formatAfterCompletion)
        {
            await FormatCodeAsync();
            return;
        }

        if (!accepted && entered && formatAfterEnter)
        {
            await Task.Delay(formatDelayMs);
            await FormatCodeAsync();
            return;
        }

        if (!accepted && (formatOnSemicolon || formatOnBrace))
        {
            var typed = await JSRuntime.InvokeAsync<string>(
                "playgroundCompletion.getCharBeforeCaret",
                "code-editor");

            if ((formatOnSemicolon && typed == ";") || (formatOnBrace && typed == "}"))
            {
                await Task.Delay(formatDelayMs);
                await FormatCodeAsync();
                return;
            }
        }

        if (!AutoSemanticCompletion)
        {
            return;
        }

        completionDebounce?.Cancel();
        var cts = new CancellationTokenSource();
        completionDebounce = cts;

        try
        {
            await Task.Delay(semanticDelayMs, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (AutoSemanticCompletion)
        {
            await ShowSemanticCompletionsAsync();
        }
    }

    private async Task ShowSemanticCompletionsAsync()
    {
        if (isSemanticBusy)
        {
            return;
        }

        isSemanticBusy = true;
        StateHasChanged();

        try
        {
            var displayPosition = await JSRuntime.InvokeAsync<int>("playgroundCompletion.getSelectionStart", "code-editor");
            var (code, position) = BuildCompletionSource(displayPosition);
            position = Math.Clamp(position, 0, code.Length);

            if (position > 0)
            {
                var last = code[position - 1];
                if (!char.IsLetterOrDigit(last) && last != '_' && last != '.')
                {
                    return;
                }
            }

            var json = await JSRuntime.InvokeAsync<string>("roslynWorker.complete", code, position, targetFramework);
            var suggestions = JsonSerializer.Deserialize<string[]>(json) ?? Array.Empty<string>();

            // Keep the instant syntax-keyword menu when semantic completion
            // has no result; only replace it when we actually have symbols.
            if (suggestions.Length > 0)
            {
                await JSRuntime.InvokeVoidAsync("playgroundCompletion.show", (object)suggestions);
            }
        }
        catch
        {
            // Completion must never break normal editing.
        }
        finally
        {
            isSemanticBusy = false;
            StateHasChanged();
        }
    }

    private string[] GetSemanticCompletions(int displayPosition)
    {
        try
        {
            var (code, position) = BuildCompletionSource(displayPosition);
            if (code.Length == 0 || code.Length > 30000)
            {
                return Array.Empty<string>();
            }

            var earlyPosition = Math.Clamp(position, 0, code.Length);
            var earlyWordStart = earlyPosition;
            while (earlyWordStart > 0 &&
                   (char.IsLetterOrDigit(code[earlyWordStart - 1]) || code[earlyWordStart - 1] == '_'))
            {
                earlyWordStart--;
            }

            var earlyMemberAccess = earlyWordStart > 0 && code[earlyWordStart - 1] == '.';
            if (!earlyMemberAccess && earlyPosition - earlyWordStart < 2)
            {
                return Array.Empty<string>();
            }

            var tree = CSharpSyntaxTree.ParseText(code);
            var references = GetMetadataReferences();
            var compilation = CSharpCompilation.Create(
                "CompletionAssembly",
                new[] { tree },
                references,
                new CSharpCompilationOptions(OutputKind.DynamicallyLinkedLibrary));
            var model = compilation.GetSemanticModel(tree);
            var root = tree.GetRoot();

            position = Math.Clamp(position, 0, code.Length);
            var wordStart = position;
            while (wordStart > 0 &&
                   (char.IsLetterOrDigit(code[wordStart - 1]) || code[wordStart - 1] == '_'))
            {
                wordStart--;
            }

            var isMemberAccess = wordStart > 0 && code[wordStart - 1] == '.';
            var prefix = code[wordStart..position];
            if (prefix.Length == 0 && !isMemberAccess)
            {
                return Array.Empty<string>();
            }

            var suggestions = new HashSet<string>(StringComparer.Ordinal);
            if (isMemberAccess)
            {
                var token = root.FindToken(Math.Max(0, wordStart - 2));
                var typeInfo = model.GetTypeInfo(token.Parent!);
                var type = typeInfo.Type ?? typeInfo.ConvertedType;
                if (type != null)
                {
                    foreach (var member in type.GetMembers())
                    {
                        if (!member.IsImplicitlyDeclared && member.CanBeReferencedByName)
                        {
                            suggestions.Add(member.Name);
                        }
                    }
                }
            }
            else
            {
                foreach (var symbol in model.LookupSymbols(position))
                {
                    if (symbol.CanBeReferencedByName)
                    {
                        suggestions.Add(symbol.Name);
                    }
                }

                foreach (var keyword in CompletionKeywords)
                {
                    suggestions.Add(keyword);
                }
            }

            return suggestions
                .Where(item => prefix.Length == 0 || item.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                .OrderBy(item => item, StringComparer.OrdinalIgnoreCase)
                .Take(24)
                .ToArray();
        }
        catch
        {
            return Array.Empty<string>();
        }
    }

    private (string Code, int Position) BuildCompletionSource(int displayPosition)
    {
        displayPosition = Math.Clamp(displayPosition, 0, displayCode.Length);
        if (showFullCode)
        {
            return (displayCode, displayPosition);
        }

        const string prefix = "using System;\n\npublic class Program\n{\n    public static void Main()\n    {\n";
        var before = displayCode[..displayPosition];
        var lines = before.Split('\n');
        var sourcePosition = prefix.Length;

        for (var i = 0; i < lines.Length - 1; i++)
        {
            sourcePosition += (string.IsNullOrWhiteSpace(lines[i]) ? 0 : 8) + lines[i].Length + 1;
        }

        sourcePosition += (string.IsNullOrWhiteSpace(lines[^1]) ? 0 : 8) + lines[^1].Length;

        var code = prefix + IndentCode(displayCode, "        ") + "\n    }\n}";
        return (code, sourcePosition);
    }

    private List<MetadataReference> GetMetadataReferences()
    {
        if (cachedMetadataReferences != null && cachedMetadataReferencesTarget == targetFramework)
        {
            return cachedMetadataReferences;
        }

        var references = new List<MetadataReference>();
        try
        {
            var referenceAssemblyType = GetReferenceAssemblyType(targetFramework);
            var referencesType = referenceAssemblyType.GetNestedType("References");
            if (referencesType != null)
            {
                foreach (var property in referencesType.GetProperties(BindingFlags.Public | BindingFlags.Static))
                {
                    var value = property.GetValue(null);
                    if (value is MetadataReference reference)
                    {
                        references.Add(reference);
                    }
                    else if (value is IEnumerable<MetadataReference> collection)
                    {
                        references.AddRange(collection);
                    }
                }
            }
        }
        catch
        {
            // Fall back to an empty reference set; keyword completion still works.
        }

        cachedMetadataReferences = references;
        cachedMetadataReferencesTarget = targetFramework;
        return references;
    }

    private static string ResolveAccent(string value)
    {
        var palette = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["indigo"] = "#6366f1",
            ["blue"] = "#3b82f6",
            ["emerald"] = "#10b981",
            ["amber"] = "#f59e0b",
            ["rose"] = "#f43f5e",
            ["violet"] = "#8b5cf6",
            ["cyan"] = "#06b6d4",
            ["orange"] = "#f97316"
        };

        if (palette.TryGetValue(value, out var named))
        {
            return named;
        }

        var hex = value.Trim().TrimStart('#');
        return hex.Length == 6 && hex.All(c => Uri.IsHexDigit(c)) ? $"#{hex}" : palette["indigo"];
    }

    private static string HexToRgb(string hex)
    {
        var value = hex.TrimStart('#');
        if (value.Length != 6 || !value.All(c => Uri.IsHexDigit(c)))
        {
            return "99, 102, 241";
        }

        return $"{Convert.ToInt32(value[..2], 16)}, {Convert.ToInt32(value[2..4], 16)}, {Convert.ToInt32(value[4..6], 16)}";
    }

    protected override void OnInitialized()
    {
        ApplyStyleParameters();
        ApplyCodeParameter();

        // Set welcome message based on system output toggle
        if (showSystemOutput)
        {
            output = WelcomeMessage;
            systemOutput = WelcomeMessage;
        }
        
        // Initialize the display code based on the toggle state
        // On first load, the displayCode is already set to the unindented sample
