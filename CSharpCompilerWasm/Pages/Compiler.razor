@page "/"
@page "/compiler"
@using Microsoft.CodeAnalysis
@using Microsoft.CodeAnalysis.CSharp
@using Microsoft.CodeAnalysis.Emit
@using System.IO
@using System.Reflection
@using System.Text
@using Microsoft.JSInterop
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>C# Playground</PageTitle>

<script>
    window.scrollToBottom = (elementId) => {
        const element = document.getElementById(elementId);
        if (element) {
            element.scrollTop = element.scrollHeight;
        }
    };



    window.playgroundCompletion = (() => {
        const words = [
            "Console", "WriteLine", "Write", "ReadLine", "System", "Math",
            "using", "public", "private", "protected", "internal", "static",
            "class", "struct", "record", "interface", "enum", "namespace",
            "void", "int", "long", "double", "float", "decimal", "bool",
            "char", "string", "object", "var", "new", "return", "if", "else",
            "for", "foreach", "while", "do", "switch", "case", "break",
            "continue", "try", "catch", "finally", "throw", "true", "false",
            "null", "List", "Dictionary", "StringBuilder", "TryParse", "Round",
            "ToString", "Length", "Count", "Add", "Contains"
        ];
        const members = [
            "WriteLine", "Write", "ReadLine", "ToString", "Length", "Count",
            "Add", "Contains", "TryParse", "Round", "Substring", "ToUpper",
            "ToLower", "Trim", "Split", "Replace", "StartsWith", "EndsWith"
        ];
        const snippets = [
            {
                label: "for",
                detail: "for 循环",
                insertText: "for (int i = 0; i < length; i++)\n{\n    \n}",
                selectText: "length"
            },
            {
                label: "foreach",
                detail: "foreach 遍历",
                insertText: "foreach (var item in items)\n{\n    \n}",
                selectText: "items"
            },
            {
                label: "if",
                detail: "if 条件",
                insertText: "if (condition)\n{\n    \n}",
                selectText: "condition"
            },
            {
                label: "while",
                detail: "while 循环",
                insertText: "while (condition)\n{\n    \n}",
                selectText: "condition"
            },
            {
                label: "do",
                detail: "do-while 循环",
                insertText: "do\n{\n    \n} while (condition);",
                selectText: "condition"
            },
            {
                label: "switch",
                detail: "switch 分支",
                insertText: "switch (value)\n{\n    case 1:\n        break;\n    default:\n        break;\n}",
                selectText: "value"
            },
            {
                label: "try",
                detail: "try-catch",
                insertText: "try\n{\n    \n}\ncatch (Exception ex)\n{\n    Console.WriteLine(ex.Message);\n}",
                selectText: "Exception"
            }
        ];

        let textarea = null;
        let menu = null;
        let matches = [];
        let active = -1;
        let suppressUntil = 0;
        let localTimer = null;
        let acceptedByUser = false;
        let enterPending = false;
        let previewCollapsed = false;
        let listWidth = 360;
        let previewWidth = 280;
        let localDelayMs = 120;
        let autoIndentOnEnter = true;
        let dedentOnCloseBrace = true;
        let autoIndentOnPaste = true;
        let snippetsEnabled = true;
        let snippetPreviewEnabled = true;

        function updateLocal() {
            if (Date.now() < suppressUntil) {
                hide();
                return;
            }

            const before = textarea ? textarea.value.slice(0, textarea.selectionStart) : "";
            if (/\.\s*$/.test(before)) {
                matches = localSuggestions("", true).slice(0, 8);
                active = 0;
                render();
                return;
            }

            const value = prefix();
            if (value.length < 1) {
                hide();
                return;
            }

            matches = localSuggestions(value, false).slice(0, 8);
            active = matches.length > 0 ? 0 : -1;
            render();
        }

        function hide() {
            if (menu) {
                menu.classList.remove("is-visible");
                menu.innerHTML = "";
            }
            active = -1;
        }

        function prefix() {
            if (!textarea) return "";
            const before = textarea.value.slice(0, textarea.selectionStart);
            const match = before.match(/[\p{L}_][\p{L}\p{N}_]*$/u);
            return match ? match[0] : "";
        }

        function normalizeItem(item) {
            if (typeof item === "string") {
                return { label: item, insertText: item };
            }
            return {
                label: item.label || item.insertText || "",
                insertText: item.insertText || item.label || "",
                detail: item.detail || "",
                selectText: item.selectText || ""
            };
        }

        function dedupe(items) {
            const seen = new Set();
            return items.filter((item) => {
                const key = item.label.toLowerCase();
                if (seen.has(key)) return false;
                seen.add(key);
                return true;
            });
        }

        function localSuggestions(value, memberContext) {
            if (memberContext) {
                return members.map(normalizeItem);
            }

            if (!value) return [];

            const lower = value.toLowerCase();
            const snippetItems = snippetsEnabled
                ? snippets
                    .filter(item => item.label.toLowerCase().startsWith(lower))
                    .map(normalizeItem)
                : [];
            const keywordItems = words
                .filter(word => word.toLowerCase().startsWith(lower))
                .map(normalizeItem);

            return dedupe([...snippetItems, ...keywordItems]);
        }

        function applyMenuTheme() {
            const shell = document.querySelector(".compiler-container.app-shell");
            if (!shell || !menu) return;

            const styles = getComputedStyle(shell);
            menu.style.setProperty("--completion-bg", styles.getPropertyValue("--surface").trim());
            menu.style.setProperty("--completion-text", styles.getPropertyValue("--text").trim());
            menu.style.setProperty("--completion-border", styles.getPropertyValue("--border").trim());
            menu.style.setProperty("--completion-active-bg", "rgba(" + styles.getPropertyValue("--accent-rgb").trim() + ", .20)");
            menu.style.setProperty("--completion-active-text", styles.getPropertyValue("--accent").trim());
            menu.style.setProperty("--completion-shadow", styles.getPropertyValue("--shadow").trim());
        }

        function positionMenu() {
            if (!textarea || !menu) return;
            applyMenuTheme();
            const rect = textarea.getBoundingClientRect();
            const lineHeight = parseFloat(getComputedStyle(textarea).lineHeight) || 20;
            const line = textarea.value.slice(0, textarea.selectionStart).split("\n").length - 1;
            const top = Math.min(
                rect.top + 14 + (line + 1) * lineHeight - textarea.scrollTop,
                rect.bottom - 110
            );
            menu.style.left = (rect.left + 14) + "px";
            menu.style.top = Math.max(rect.top + 8, top) + "px";
            const hasPreview = !!menu.querySelector(".code-completion-preview");
            const desiredWidth = listWidth + (hasPreview ? previewWidth + 5 : 0);
            menu.style.width = Math.max(240, Math.min(rect.width - 28, desiredWidth)) + "px";
        }

        function ensureActiveVisible() {
            const item = menu.querySelector(".code-completion-item.active");
            if (!item) return;

            const menuRect = menu.getBoundingClientRect();
            const itemRect = item.getBoundingClientRect();
            if (itemRect.top < menuRect.top) {
                menu.scrollTop -= menuRect.top - itemRect.top;
            } else if (itemRect.bottom > menuRect.bottom) {
                menu.scrollTop += itemRect.bottom - menuRect.bottom;
            }
        }

        function startResize(kind, event) {
            event.preventDefault();
            const startX = event.clientX;
            const startWidth = kind === "list" ? listWidth : previewWidth;

            const move = (moveEvent) => {
                const nextWidth = Math.max(
                    kind === "list" ? 220 : 160,
                    Math.min(kind === "list" ? 720 : 520, startWidth + moveEvent.clientX - startX));

                if (kind === "list") {
                    listWidth = nextWidth;
                    const list = menu.querySelector(".code-completion-list");
                    if (list) list.style.width = listWidth + "px";
                }
                else {
                    previewWidth = nextWidth;
                    const preview = menu.querySelector(".code-completion-preview");
                    if (preview) preview.style.width = previewWidth + "px";
                }

                positionMenu();
            };
            const up = () => {
                document.removeEventListener("mousemove", move);
                document.removeEventListener("mouseup", up);
            };

            document.addEventListener("mousemove", move);
            document.addEventListener("mouseup", up);
        }

        function render() {
            menu.innerHTML = "";

            const body = document.createElement("div");
            body.className = "code-completion-body";

            const list = document.createElement("div");
            list.className = "code-completion-list";
            list.style.width = listWidth + "px";

            matches.forEach((entry, index) => {
                const item = document.createElement("div");
                item.className = "code-completion-item" + (index === active ? " active" : "");
                item.dataset.index = index;

                const text = document.createElement("div");
                text.className = "code-completion-text";

                const label = document.createElement("span");
                label.className = "code-completion-label";
                label.textContent = entry.label;
                text.appendChild(label);

                if (entry.detail) {
                    const detail = document.createElement("span");
                    detail.className = "code-completion-detail";
                    detail.textContent = entry.detail;
                    text.appendChild(detail);
                }

                item.appendChild(text);

                if (snippetPreviewEnabled && entry.insertText?.includes("\n")) {
                    const fold = document.createElement("button");
                    fold.type = "button";
                    fold.className = "code-completion-fold";
                    fold.title = previewCollapsed ? "展开预览" : "折叠预览";
                    fold.textContent = previewCollapsed ? ">" : "<";
                    fold.addEventListener("mousedown", (foldEvent) => {
                        foldEvent.preventDefault();
                        foldEvent.stopPropagation();
                        previewCollapsed = !previewCollapsed;
                        render();
                    });
                    item.appendChild(fold);
                }

                list.appendChild(item);
            });

            body.appendChild(list);

            const activeEntry = matches[active];
            if (snippetPreviewEnabled && activeEntry?.insertText?.includes("\n") && !previewCollapsed) {
                const resizer = document.createElement("div");
                resizer.className = "code-completion-resizer";
                resizer.title = "拖动调整菜单宽度";
                resizer.addEventListener("mousedown", (event) => startResize("list", event));
                body.appendChild(resizer);

                const preview = document.createElement("pre");
                preview.className = "code-completion-preview";
                preview.style.width = previewWidth + "px";
                preview.textContent = activeEntry.insertText;
                body.appendChild(preview);

                const previewResizer = document.createElement("div");
                previewResizer.className = "code-completion-resizer-right";
                previewResizer.title = "拖动调整预览宽度";
                previewResizer.addEventListener("mousedown", (event) => startResize("preview", event));
                body.appendChild(previewResizer);
            }
            else {
                const rightResizer = document.createElement("div");
                rightResizer.className = "code-completion-resizer-right";
                rightResizer.title = "拖动调整菜单宽度";
                rightResizer.addEventListener("mousedown", (event) => startResize("list", event));
                body.appendChild(rightResizer);
            }

            menu.appendChild(body);

            positionMenu();
            menu.classList.toggle("is-visible", matches.length > 0);
            ensureActiveVisible();
        }

        function update() {
            const value = prefix();
            if (value.length < 1) {
                hide();
                return;
            }

            matches = localSuggestions(value, false).slice(0, 8);
            active = matches.length > 0 ? 0 : -1;
            render();
        }

        function insertNewLine() {
            if (!textarea) return;

            const value = textarea.value;
            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            const before = value.slice(0, start);
            const lineStart = before.lastIndexOf("\n") + 1;
            const currentLine = before.slice(lineStart);
            const leading = (currentLine.match(/^[ \t]*/) || [""])[0];
            const trimmed = currentLine.trimEnd();
            let indent = leading;

            if (/[{([]\s*$/.test(trimmed)) {
                indent += "    ";
            }

            enterPending = true;
            textarea.setRangeText("\n" + indent, start, end, "end");
            textarea.dispatchEvent(new Event("input", { bubbles: true }));
            textarea.focus();
        }

        function handlePaste(event) {
            if (!textarea || textarea.readOnly || !autoIndentOnPaste) return;

            const pasted = event.clipboardData?.getData("text/plain") ?? "";
            if (!pasted.includes("\n")) return;

            event.preventDefault();

            const value = textarea.value;
            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            const before = value.slice(0, start);
            const lineStart = before.lastIndexOf("\n") + 1;
            const currentLine = before.slice(lineStart);
            const baseIndent = (currentLine.match(/^[ \t]*/) || [""])[0];
            const lines = pasted.replace(/\r\n?/g, "\n").split("\n");
            const indents = lines
                .filter(line => line.trim().length > 0)
                .map(line => (line.match(/^[ \t]*/) || [""])[0].length);
            const commonIndent = indents.length > 0 ? Math.min(...indents) : 0;

            const adjusted = lines.map((line, index) => {
                const stripped = line.slice(Math.min(commonIndent, line.length));
                return index === 0 ? stripped : baseIndent + stripped;
            }).join("\n");

            textarea.setRangeText(adjusted, start, end, "end");
            textarea.dispatchEvent(new Event("input", { bubbles: true }));
            textarea.focus();
        }

        function insertIndent(outdent) {
            if (!textarea) return;

            const value = textarea.value;
            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;

            if (start === end && !outdent) {
                textarea.setRangeText("    ", start, end, "end");
                textarea.dispatchEvent(new Event("input", { bubbles: true }));
                textarea.focus();
                return;
            }

            const lineStart = value.lastIndexOf("\n", start - 1) + 1;
            let lineEnd = value.indexOf("\n", end);
            if (lineEnd < 0) lineEnd = value.length;

            const block = value.slice(lineStart, lineEnd);
            const lines = block.split("\n").map((line) => {
                if (outdent) {
                    return line.replace(/^ {1,4}/, "");
                }
                return "    " + line;
            });
            const replacement = lines.join("\n");
            textarea.setRangeText(replacement, lineStart, lineEnd, "end");
            textarea.setSelectionRange(lineStart, lineStart + replacement.length);
            textarea.dispatchEvent(new Event("input", { bubbles: true }));
            textarea.focus();
        }

        function apply(index) {
            if (!textarea || index < 0 || index >= matches.length) return;

            const value = prefix();
            const start = textarea.selectionStart - value.length;
            const entry = matches[index];
            const beforeSelection = textarea.selectionStart;
            const textareaValue = textarea.value;
            const lineStart = textareaValue.lastIndexOf("\n", start - 1) + 1;
            const linePrefix = textareaValue.slice(lineStart, start);
            const baseIndent = (linePrefix.match(/^[ \t]*/) || [""])[0];
            const insertion = (entry.insertText || entry.label)
                .replace(/\r\n?/g, "\n")
                .split("\n")
                .map((line, lineIndex) => lineIndex === 0 || !line ? line : baseIndent + line)
                .join("\n");

            textarea.setRangeText(insertion, start, beforeSelection, "end");

            if (entry.selectText) {
                const selectStart = start + insertion.indexOf(entry.selectText);
                if (selectStart >= start) {
                    textarea.setSelectionRange(selectStart, selectStart + entry.selectText.length);
                }
            }
            else {
                const position = start + insertion.length;
                textarea.setSelectionRange(position, position);
            }

            acceptedByUser = true;
            textarea.dispatchEvent(new Event("input", { bubbles: true }));
            textarea.focus();
            suppressUntil = Date.now() + 600;
            hide();
        }

        function attach(textareaId, menuId) {
            if (textarea) return;
            textarea = document.getElementById(textareaId);
            if (!textarea) return;

            // Keep the menu outside Blazor's render tree so component updates
            // cannot reset its visibility while the user is choosing an item.
            menu = document.createElement("div");
            menu.id = menuId;
            menu.className = "code-completion";
            menu.setAttribute("role", "listbox");
            menu.setAttribute("aria-label", "代码提示");
            document.body.appendChild(menu);

            const settingsDetails = document.querySelector(".editor-settings");
            const positionSettingsPanel = () => {
                if (!settingsDetails?.open) return;
                const summary = settingsDetails.querySelector("summary");
                const panel = settingsDetails.querySelector(".settings-panel");
                if (!summary || !panel) return;

                const rect = summary.getBoundingClientRect();
                const margin = 8;
                const spaceBelow = window.innerHeight - rect.bottom - margin * 2;
                const spaceAbove = rect.top - margin * 2;
                const openUp = spaceBelow < 240 && spaceAbove > spaceBelow;

                panel.style.position = "fixed";
                panel.style.boxSizing = "border-box";
                panel.style.right = Math.max(margin, window.innerWidth - rect.right) + "px";
                panel.style.width = Math.min(320, window.innerWidth - margin * 2) + "px";
                panel.style.maxHeight = Math.max(120, Math.min(680, (openUp ? spaceAbove : spaceBelow) - 24)) + "px";
                if (openUp) {
                    panel.style.top = "auto";
                    panel.style.bottom = (window.innerHeight - rect.top + margin) + "px";
                }
                else {
                    panel.style.bottom = "auto";
                    panel.style.top = (rect.bottom + margin) + "px";
                }
            };

            if (settingsDetails) {
                settingsDetails.addEventListener("toggle", () => requestAnimationFrame(positionSettingsPanel));
                window.addEventListener("resize", positionSettingsPanel);
                window.addEventListener("scroll", positionSettingsPanel, true);
            }

            textarea.addEventListener("input", () => {
                hide();
                clearTimeout(localTimer);
                localTimer = setTimeout(updateLocal, localDelayMs);
            });
            textarea.addEventListener("paste", handlePaste);
            document.addEventListener("mousedown", (event) => {
                if (event.target !== textarea && !menu.contains(event.target)) {
                    hide();
                }
            });
            textarea.addEventListener("keydown", (event) => {
                if (dedentOnCloseBrace && event.key === "}" && !event.ctrlKey && !event.metaKey && !event.altKey) {
                    const value = textarea.value;
                    const start = textarea.selectionStart;
                    const end = textarea.selectionEnd;
                    const lineStart = value.lastIndexOf("\n", start - 1) + 1;
                    const beforeLine = value.slice(lineStart, start);

                    if (start === end && /^[ \t]+$/.test(beforeLine)) {
                        event.preventDefault();
                        const remove = Math.min(4, beforeLine.length);
                        const indentation = beforeLine.slice(0, beforeLine.length - remove);
                        textarea.setRangeText(indentation + "}", lineStart, start, "end");
                        textarea.dispatchEvent(new Event("input", { bubbles: true }));
                        textarea.focus();
                        return;
                    }
                }

                if (event.key === "Enter" && !event.ctrlKey && !event.metaKey && !event.altKey) {
                    if (menu.classList.contains("is-visible") && active >= 0) {
                        event.preventDefault();
                        apply(active);
                    }
                    else {
                        enterPending = true;
                        if (autoIndentOnEnter) {
                            event.preventDefault();
                            insertNewLine();
                        }
                    }
                    return;
                }

                if (event.key === "Tab" && !event.ctrlKey && !event.metaKey && !event.altKey) {
                    event.preventDefault();
                    if (menu.classList.contains("is-visible") && active >= 0) {
                        apply(active);
                    }
                    else {
                        insertIndent(event.shiftKey);
                    }
                    return;
                }

                if (event.ctrlKey || event.metaKey || event.altKey) return;
                if (!menu.classList.contains("is-visible")) return;

                if (event.key === "ArrowDown" || event.key === "ArrowUp") {
                    event.preventDefault();
                    const delta = event.key === "ArrowDown" ? 1 : -1;
                    active = (active + delta + matches.length) % matches.length;
                    render();
                } else if (event.key === "Enter") {
                    if (active >= 0) {
                        event.preventDefault();
                        event.stopPropagation();
                        apply(active);
                    }
                } else if (event.key === "Escape") {
                    event.preventDefault();
                    hide();
                }
            });

            menu.addEventListener("mousedown", (event) => {
                const item = event.target.closest("[data-index]");
                if (!item) return;
                event.preventDefault();
                apply(Number(item.dataset.index));
            });
        }

        document.addEventListener("click", (event) => {
            const settings = document.querySelector(".editor-settings");
            if (settings?.open && !settings.contains(event.target)) {
                settings.open = false;
            }
        });
        document.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;
            const settings = document.querySelector(".editor-settings");
            if (settings?.open) {
                settings.open = false;
            }
        });

        function localKeywordSuggestions() {
            const value = prefix();
            if (!value) return [];
            return localSuggestions(value, false).slice(0, 8);
        }

        function show(items) {
            if (Date.now() < suppressUntil) return;
            if (arguments.length > 1) {
                items = Array.from(arguments);
            }
            else if (typeof items === "string") {
                items = [items];
            }
            const semantic = Array.isArray(items) ? items.map(normalizeItem).slice(0, 12) : [];
            // Never let an empty/unexpected semantic response erase the local
            // keyword menu that is already visible.
            if (semantic.length === 0) {
                return;
            }

            const before = textarea ? textarea.value.slice(0, textarea.selectionStart) : "";
            const memberContext = /\.\s*$/.test(before);
            const merged = memberContext
                ? semantic
                : [...localKeywordSuggestions(), ...semantic];

            matches = dedupe(merged).slice(0, 12);
            active = 0;
            render();
        }

        function getSelectionStart(elementId) {
            const element = document.getElementById(elementId);
            return element ? element.selectionStart : 0;
        }

        function getCharBeforeCaret(elementId) {
            const element = document.getElementById(elementId);
            if (!element || element.selectionStart < 1) return "";
            return element.value.charAt(element.selectionStart - 1);
        }

        function setSelectionStart(elementId, position) {
            const element = document.getElementById(elementId);
            if (!element) return;
            const safePosition = Math.max(0, Math.min(position, element.value.length));
            element.focus();
            element.setSelectionRange(safePosition, safePosition);
        }

        function configure(options) {
            if (!options) return;
            if (Number.isFinite(options.localDelayMs)) {
                localDelayMs = Math.max(0, Math.min(2000, options.localDelayMs));
            }
            if (typeof options.autoIndentOnEnter === "boolean") {
                autoIndentOnEnter = options.autoIndentOnEnter;
            }
            if (typeof options.dedentOnCloseBrace === "boolean") {
                dedentOnCloseBrace = options.dedentOnCloseBrace;
            }
            if (typeof options.autoIndentOnPaste === "boolean") {
                autoIndentOnPaste = options.autoIndentOnPaste;
            }
            if (typeof options.snippetsEnabled === "boolean") {
                snippetsEnabled = options.snippetsEnabled;
            }
            if (typeof options.snippetPreviewEnabled === "boolean") {
                snippetPreviewEnabled = options.snippetPreviewEnabled;
            }
        }

        function consumeAccepted() {
            const value = acceptedByUser;
            acceptedByUser = false;
            return value;
        }

        function consumeEnter() {
            const value = enterPending;
            enterPending = false;
            return value;
        }

        return { attach, show, hide, getSelectionStart, getCharBeforeCaret, setSelectionStart, configure, consumeAccepted, consumeEnter };
    })();

    window.playgroundShortcuts = (() => {
        let pendingResolve = null;

        function formatCombo(event) {
            if (["Control", "Shift", "Alt", "Meta"].includes(event.key)) {
                return null;
            }

            const parts = [];
            if (event.ctrlKey) parts.push("Ctrl");
            if (event.shiftKey) parts.push("Shift");
            if (event.altKey) parts.push("Alt");
            parts.push(event.key === " " ? "Space" : event.key.length === 1 ? event.key.toUpperCase() : event.key);
            return parts.join("+");
        }

        document.addEventListener("keydown", (event) => {
            if (!pendingResolve) return;
            const combo = formatCombo(event);
            if (!combo) return;

            event.preventDefault();
            event.stopPropagation();
            const resolve = pendingResolve;
            pendingResolve = null;
            resolve(combo);
        }, true);

        const storageKey = "csharp-playground:shortcuts";

        return {
            captureNext: () => new Promise(resolve => {
                pendingResolve = resolve;
            }),
            load: () => {
                try {
                    return localStorage.getItem(storageKey) || "{}";
                }
                catch {
                    return "{}";
                }
            },
            save: (value) => {
                try {
                    localStorage.setItem(storageKey, typeof value === "string" ? value : JSON.stringify(value));
                }
                catch {
                    // Storage may be disabled.
                }
            }
        };
    })();

    window.playgroundHost = {
        run: async (code) => {
            const textarea = document.getElementById("code-editor");
            const button = document.querySelector(".compile-btn");
            if (!textarea || !button) {
                throw new Error("Playground editor is not ready.");
            }
            if (textarea.readOnly) {
                throw new Error("Playground is read-only.");
            }

            textarea.value = String(code ?? "");
            textarea.dispatchEvent(new Event("input", { bubbles: true }));
            await new Promise(resolve => setTimeout(resolve, 80));

            button.click();
            const started = Date.now();
            await new Promise(resolve => setTimeout(resolve, 80));
            while (button.disabled && Date.now() - started < 120000) {
                await new Promise(resolve => setTimeout(resolve, 100));
            }
            await new Promise(resolve => setTimeout(resolve, 200));

            return document.getElementById("output")?.textContent || "";
        }
    };

    window.addEventListener("message", async (event) => {
        const data = event.data;
        if (!data || data.type !== "csharp-playground:run") {
            return;
        }

        const requestId = data.requestId ?? "";
        const targetOrigin = event.origin && event.origin !== "null" ? event.origin : "*";

        try {
            const output = await window.playgroundHost.run(data.code);
            event.source?.postMessage({
                type: "csharp-playground:result",
                requestId,
                output
            }, targetOrigin);
        }
        catch (error) {
            event.source?.postMessage({
                type: "csharp-playground:result",
                requestId,
                error: error?.message || String(error)
            }, targetOrigin);
        }
    });

    window.promptForInput = async (newOutputText) => {
        return new Promise((resolve) => {
            const outputElement = document.getElementById('output');
            if (outputElement) {
                // Don't display output yet - just collect the input
                // We'll display everything at the end when the program completes
                
                // Create a container for the input line
                const inputContainer = document.createElement('div');
                inputContainer.className = 'interactive-output';



                
                // Add the ">" indicator
                const promptIndicator = document.createElement('span');
                promptIndicator.textContent = '>';
                promptIndicator.className = 'console-prompt';




                inputContainer.appendChild(promptIndicator);
                
                // Create input field
                const inputField = document.createElement('input');
                inputField.type = 'text';
                inputField.className = 'console-input';









                
                // Handle input submission
                inputField.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        const value = inputField.value;
                        
                        // Remove the input container completely - don't show anything yet
                        inputContainer.remove();
                        
                        resolve(value);
                    }
                });
                
                // Add input field to container
                inputContainer.appendChild(inputField);
                
                // Add container to output
                outputElement.appendChild(inputContainer);
                
                // Focus the input field and scroll to bottom
                inputField.focus();
                window.scrollToBottom('output');
            } else {
                // Fallback to browser prompt
                resolve(prompt(newOutputText) || '');
            }
        });
    };
    
    window.clearInteractiveOutput = () => {
        try {
            const outputElement = document.getElementById('output');
            if (outputElement) {
                const interactiveElements = outputElement.querySelectorAll('.interactive-output');
                interactiveElements.forEach(el => el.remove());
            }
        } catch (e) {
            // Silently ignore errors during cleanup
            console.log('clearInteractiveOutput error:', e);
        }
    };
    
    window.clearAllOutput = () => {
        try {
            const outputElement = document.getElementById('output');
            if (outputElement && outputElement.firstChild) {
                // Remove ALL children, not just interactive ones
                while (outputElement.firstChild) {
                    outputElement.removeChild(outputElement.firstChild);
                }
            }
        } catch (e) {
            // Silently ignore errors during cleanup
            console.log('clearAllOutput error:', e);
        }
    };
</script>

