    private async Task CompileAndRun()
    {
        var waitStarted = DateTime.UtcNow;
        isCompiling = true;
        HideCompletion();

        // Blazor WebAssembly is single-threaded: Roslyn compilation blocks the
        // browser main thread. Yield once so Blazor can paint the waiting state
        // before the synchronous compile/execute work starts.
        StateHasChanged();
        await Task.Delay(40);
        
        // Clear output variables - let Blazor handle the DOM updates
        if (!showSystemOutput)
        {
            userOutput = "";
            errorOutput = "";
            output = "";
            systemOutput = "";
        }
        
        AddOutput("Compiling C# code with real Roslyn compiler...", "info");
        
        // Only update UI if system output is visible
        if (showSystemOutput)
        {
            StateHasChanged();
            await ScrollToBottom();
        }

        try
        {
            // Ensure we have the current full source code
            if (!showFullCode)
            {
                // If we're in simplified mode, update the source code from displayCode
                OnCodeChanged(new ChangeEventArgs { Value = displayCode });
            }
            
            var result = await CompileCSharpCodeViaWorker(sourceCode);
            
            if (result.Success)
            {
                AddOutput("Roslyn compilation successful!", "success");
                AddOutput("Executing compiled assembly in .NET WebAssembly...", "info");
                
                // DON'T call StateHasChanged here - we don't want Blazor to render
                // any of these messages while the interactive execution is happening
                
                var executionResult = result.AssemblyBytes is { Length: > 0 }
                    ? await ExecuteAssemblyInWorker(result.AssemblyBytes)
                    : await ExecuteAssembly(result.Assembly!);
                
                // Now that interactive execution is done, add completion message
                AddOutput(".NET WebAssembly execution completed successfully!", "success");
                
                // Only update UI if system output is visible
                if (showSystemOutput)
                {
                    StateHasChanged();
                    await ScrollToBottom();
                }
            }
            else
            {
                AddErrorOutput("Compilation failed with Roslyn:", "error");
                
                foreach (var error in result.Errors)
                {
                    var lineNumber = error.Location.GetLineSpan().StartLinePosition.Line + 1;
                    AddErrorOutput($"Line {lineNumber}: {error.GetMessage()}", "error");
                }
                
                foreach (var error in result.ErrorMessages)
                {
                    AddErrorOutput(error, "error");
                }

                // Display errors using the same strategy as regular output
                if (showSystemOutput)
                {
                    // Use Blazor rendering
                    StateHasChanged();
                    await ScrollToBottom();
                }
                else
                {
                    // Use JavaScript rendering to avoid race condition
                    await DisplayErrorsViaJavaScript();
                }
            }
        }
        catch (Exception ex)
        {
            AddErrorOutput($"Error: {ex.Message}", "error");
            
            if (showSystemOutput)
            {
                StateHasChanged();
                await ScrollToBottom();
            }
            else
            {
                await DisplayErrorsViaJavaScript();
            }
        }
        finally
        {
            var elapsed = DateTime.UtcNow - waitStarted;
            if (elapsed < TimeSpan.FromMilliseconds(450))
            {
                await Task.Delay(TimeSpan.FromMilliseconds(450) - elapsed);
            }
            isCompiling = false;
            StateHasChanged();
        }
    }

