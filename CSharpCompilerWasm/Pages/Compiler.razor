    private async Task HandleEditorKeyDown(KeyboardEventArgs e)
    {
        if (MatchesShortcut(e, formatShortcut))
        {
            await FormatCodeAsync();
        }
        else if (MatchesShortcut(e, runShortcut))
        {
            await CompileAndRun();
        }
        else if (MatchesShortcut(e, completionShortcut))
        {
            await ShowSemanticCompletionsAsync();
        }
        else if (MatchesShortcut(e, clearShortcut))
        {
            ClearOutput();
        }
    }

    private static bool MatchesShortcut(KeyboardEventArgs e, string shortcut)
    {
        if (string.IsNullOrWhiteSpace(shortcut))
        {
            return false;
        }

        var parts = shortcut
            .Split('+', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0)
        {
            return false;
        }

        var ctrl = parts.Contains("Ctrl", StringComparer.OrdinalIgnoreCase);
        var shift = parts.Contains("Shift", StringComparer.OrdinalIgnoreCase);
        var alt = parts.Contains("Alt", StringComparer.OrdinalIgnoreCase);
        var key = parts[^1];
        var eventKey = e.Key == " " ? "Space" : e.Key;

        return e.CtrlKey == ctrl &&
               e.ShiftKey == shift &&
               e.AltKey == alt &&
               string.Equals(eventKey, key, StringComparison.OrdinalIgnoreCase);
    }

