<div class="compiler-container app-shell @ThemeClass @LayoutClass @ChromeClass @DensityClass" style="@ContainerStyle" role="application" aria-label="C# Code Editor Application">
    <!-- Header with title -->
    <header class="header" role="banner" data-runtime="@RuntimeBadge">
        <div class="header-content">
            <h1 id="main-title">C# Playground</h1>
            <p class="subheading" aria-describedby="main-title">在浏览器里编写、编译并运行 C#</p>
        </div>
        <div class="header-actions" role="toolbar" aria-label="外观设置">
            <label class="target-picker" title="切换主题">
                <span class="target-picker-label">主题</span>
                <select value="@theme" @onchange="OnThemeChanged" aria-label="界面主题">
                    @foreach (var option in ThemeOptions)
                    {
                        <option value="@option">@GetThemeLabel(option)</option>
                    }
                </select>
            </label>
            <label class="target-picker" title="切换强调色">
                <span class="target-picker-label">颜色</span>
                <select value="@accentName" @onchange="OnAccentChanged" aria-label="强调色">
                    @foreach (var option in AccentOptions)
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </label>
        </div>
    </header>

    <!-- Code Editor Section -->
    <section class="editor-section" role="main" aria-labelledby="editor-heading">
        <div class="section-header">
            <h3 id="editor-heading">📝 C# Code Editor</h3>
            <div class="editor-controls" role="toolbar" aria-label="Editor controls">
                <details class="editor-settings">
                    <summary class="btn btn-outline-secondary btn-sm" title="编辑器设置">⚙ 设置</summary>
                    <div class="settings-panel">
                        <label class="settings-row" title="编译目标框架">
                            <span>目标框架</span>
                            <select value="@targetFramework" @onchange="OnTargetFrameworkChanged" aria-label="目标框架">
                                @foreach (var framework in SupportedTargetFrameworks)
                                {
                                    <option value="@framework">@GetTargetFrameworkLabel(framework)</option>
                                }
                            </select>
                        </label>
                        <label class="settings-row settings-check">
                            <input type="checkbox" checked="@AutoSemanticCompletion" @onchange="OnAutoCompletionChanged" />
                            <span>自动语义补全</span>
                        </label>
                        <label class="settings-row settings-check">
                            <input type="checkbox" checked="@formatAfterCompletion" @onchange="OnFormatAfterCompletionChanged" />
                            <span>接纳补全后格式化</span>
                        </label>
                        <label class="settings-row settings-check">
                            <input type="checkbox" checked="@formatAfterEnter" @onchange="OnFormatAfterEnterChanged" />
                            <span>回车后格式化</span>
                        </label>
                        <label class="settings-row settings-check">
                            <input type="checkbox" checked="@formatOnSemicolon" @onchange="OnFormatOnSemicolonChanged" />
                            <span>输入 ; 后格式化</span>
                        </label>
                        <label class="settings-row settings-check">
                            <input type="checkbox" checked="@formatOnBrace" @onchange="OnFormatOnBraceChanged" />
                            <span>输入 } 后格式化</span>
                        </label>
                        <div class="settings-section-title">缩进行为</div>
                        <label class="settings-row settings-check">
                            <input type="checkbox" checked="@autoIndentOnEnter" @onchange="OnAutoIndentOnEnterChanged" />
                            <span>Enter 自动缩进</span>
                        </label>
                        <label class="settings-row settings-check">
                            <input type="checkbox" checked="@dedentOnCloseBrace" @onchange="OnDedentOnCloseBraceChanged" />
                            <span>输入 } 自动反缩进</span>
                        </label>
                        <label class="settings-row settings-check">
                            <input type="checkbox" checked="@autoIndentOnPaste" @onchange="OnAutoIndentOnPasteChanged" />
                            <span>粘贴多行自动缩进</span>
                        </label>
                        <div class="settings-section-title">代码片段</div>
                        <label class="settings-row settings-check">
                            <input type="checkbox" checked="@snippetsEnabled" @onchange="OnSnippetsEnabledChanged" />
                            <span>启用代码片段</span>
                        </label>
                        <label class="settings-row settings-check">
                            <input type="checkbox" checked="@snippetPreviewEnabled" @onchange="OnSnippetPreviewEnabledChanged" />
                            <span>显示片段预览</span>
                        </label>
                        <label class="settings-row settings-check">
                            <input type="checkbox" checked="@prewarmCompiler" @onchange="OnPrewarmChanged" />
                            <span>空闲时预加载编译器</span>
                        </label>
                        <label class="settings-row" title="输入后显示本地提示的延迟">
                            <span>本地提示延迟</span>
                            <input type="number" min="0" max="2000" step="20" value="@localDelayMs" @onchange="OnLocalDelayChanged" />
                        </label>
                        <label class="settings-row" title="自动语义补全延迟">
                            <span>语义补全延迟</span>
                            <input type="number" min="100" max="2000" step="20" value="@semanticDelayMs" @onchange="OnSemanticDelayChanged" />
                        </label>
                        <label class="settings-row" title="尾末符号触发格式化的延迟">
                            <span>格式化延迟</span>
                            <input type="number" min="50" max="2000" step="20" value="@formatDelayMs" @onchange="OnFormatDelayChanged" />
                        </label>
                        <div class="settings-section-title">快捷键（点击录制）</div>
                        <label class="settings-row">
                            <span>运行</span>
                            <button type="button" class="shortcut-button" @onclick="CaptureRunShortcut">@runShortcut</button>
                        </label>
                        <label class="settings-row">
                            <span>格式化</span>
                            <button type="button" class="shortcut-button" @onclick="CaptureFormatShortcut">@formatShortcut</button>
                        </label>
                        <label class="settings-row">
                            <span>语义提示</span>
                            <button type="button" class="shortcut-button" @onclick="CaptureCompletionShortcut">@completionShortcut</button>
                        </label>
                        <label class="settings-row">
                            <span>清空控制台</span>
                            <button type="button" class="shortcut-button" @onclick="CaptureClearShortcut">@clearShortcut</button>
                        </label>
                        <div class="settings-actions">
                            <button class="btn btn-outline-secondary btn-sm @(isSemanticBusy ? "is-busy" : "")"
                                    @onclick="ShowSemanticCompletionsAsync"
                                    title="语义补全"
                                    aria-label="请求语义代码补全"
                                    disabled="@isSemanticBusy">
                                <span aria-hidden="true">✨</span> @(isSemanticBusy ? "分析中…" : "提示")
                            </button>
                            <button class="btn btn-outline-secondary btn-sm"
                                    @onclick="FormatCodeAsync"
                                    title="格式化代码"
                                    aria-label="格式化 C# 代码"
                                    disabled="@isFormatting">
                                <span aria-hidden="true">🧹</span> @(isFormatting ? "格式化中…" : "格式化")
                            </button>
                        </div>
                    </div>
                </details>
                <button class="btn btn-outline-secondary btn-sm" 
                        @onclick="LoadSampleCode" 
                        @onkeydown="@(async (e) => await HandleKeyDown(e, LoadSampleCode))"
                        title="Load sample code"
                        aria-label="Load sample C# code example"
                        aria-describedby="sample-code-desc">
                    <span aria-hidden="true">📄</span> Sample
                </button>
                <div id="sample-code-desc" class="sr-only">Loads a comprehensive C# code example with variables, loops, and console output</div>
                <div class="toggle-container">
                    <label class="toggle-switch" 
                           aria-label="Toggle between simplified and full code view"
                           aria-describedby="code-view-desc"
                           title="Toggle between simplified and full code view">
                        <input type="checkbox" 
                               checked="@showFullCode" 
                               @onchange="OnToggleChanged"
                               @onkeydown="@(async (e) => await HandleToggleKeyDown(e, OnToggleChanged))"
                               aria-describedby="code-view-desc"
                               role="switch"
                               aria-checked="@showFullCode" />
                        <span class="toggle-slider" aria-hidden="true"></span>
                        <span class="toggle-label" aria-hidden="true">{..}</span>
                    </label>
                    <div id="code-view-desc" class="sr-only">
                        @if (showFullCode)
                        {
                            <text>Currently showing full code with using statements and class structure. Toggle to show simplified code view.</text>
                        }
                        else
                        {
                            <text>Currently showing simplified code view with just the main method content. Toggle to show full code structure.</text>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="editor-container">

            <label for="code-editor" class="sr-only">C# Code Editor</label>
            <textarea id="code-editor"
                      @bind="displayCode" 
                      @bind:event="oninput"
                       @bind:after="OnCodeInputAsync"
                        
                      @onkeydown="HandleEditorKeyDown"
                      class="code-editor" 
                      placeholder="Write your C# code here..."
                      spellcheck="false"
                      readonly="@readonlyMode"
                      aria-label="C# code editor"
                      aria-describedby="editor-instructions"
                      role="textbox"
                      aria-multiline="true"
                      rows="15"></textarea>
            <div id="editor-instructions" class="sr-only">
                Type your C# code here. Press Ctrl+Enter to compile and run. Use the Sample button to load example code.
            </div>
        </div>
    </section>

    <!-- Compile Button Section -->
    <section class="compile-section" role="region" aria-labelledby="compile-heading">
        <h3 id="compile-heading" class="sr-only">Compile and Run</h3>
        <button class="btn btn-primary compile-btn @(isCompiling ? "is-waiting" : "")" 
                @onclick="CompileAndRun" 
                @onkeydown="@(async (e) => await HandleKeyDown(e, CompileAndRun))"
                disabled="@isCompiling" 
                aria-label="@GetCompileButtonLabel()"
                aria-describedby="compile-instructions"
                aria-live="polite"
                title="Compile and run your C# code">
            @if (isCompiling)
            {
                <span class="run-waiting" role="status" aria-label="Running...">
                    <span></span><span></span><span></span>
                </span>
                <span class="run-label">运行中</span>
            }
            else
            {
                <span class="run-icon" aria-hidden="true">&#9654;</span>
                <span class="run-label">运行代码</span>
            }
        </button>
        <div id="compile-instructions" class="sr-only">
            Compiles your C# code using the Roslyn compiler and executes it in WebAssembly. Keyboard shortcut: Ctrl+Enter from the code editor.
        </div>
    </section>


    <!-- Output Console Section -->
    <section class="output-section" role="region" aria-labelledby="output-heading" aria-live="polite">
        <div class="section-header">
            <h3 id="output-heading">&#128468; Output Console</h3>
            <div class="console-controls" role="toolbar" aria-label="Console controls">
                <div class="toggle-container">
                    <label class="toggle-switch" 
                           aria-label="Toggle system output visibility"
                           aria-describedby="system-output-desc"
                           title="Toggle system output visibility">
                        <input type="checkbox" 
                               checked="@showSystemOutput" 
                               @onchange="OnSystemOutputToggleChanged"
                               @onkeydown="@(async (e) => await HandleToggleKeyDown(e, OnSystemOutputToggleChanged))"
                               role="switch"
                               aria-checked="@showSystemOutput"
                               aria-describedby="system-output-desc" />
                        <span class="toggle-slider" aria-hidden="true"></span>
                        <span class="toggle-label" aria-hidden="true">[*]</span>
                    </label>
                    <div id="system-output-desc" class="sr-only">
                        @if (showSystemOutput)
                        {
                            <text>System output is visible. Shows compilation messages, timestamps, and debug information along with your program output.</text>
                        }
                        else
                        {
                            <text>System output is hidden. Shows only your program's console output for a cleaner view.</text>
                        }
                    </div>
                </div>
                <button class="btn btn-outline-secondary btn-sm"
                        @onclick="StopExecution"
                        disabled="@(!isCompiling)"
                        title="停止当前 Worker 执行"
                        aria-label="停止当前执行">
                    Stop
                </button>
                <button class="btn btn-outline-secondary btn-sm" 
                        @onclick="ClearOutput"
                        @onkeydown="@(async (e) => await HandleKeyDown(e, ClearOutput))"
                        aria-label="Clear console output"
                        aria-describedby="clear-instructions">
                    Clear
                </button>
                <div id="clear-instructions" class="sr-only">Clears all output from the console</div>
            </div>
        </div>
        <div class="output-container">
            <div class="output-content" 
                 id="output" 
                 role="log" 
                 aria-label="Program output"
                 aria-describedby="output-instructions"
                 aria-live="polite"
                 tabindex="0">
                @if (!string.IsNullOrEmpty(GetDisplayOutput()))
                {
                    @((MarkupString)GetDisplayOutput())
                }
            </div>
            <div id="output-instructions" class="sr-only">
                This area displays the results of your compiled C# program. Use the system output toggle to show or hide compilation details.
            </div>
        </div>
    </section>
</div>

